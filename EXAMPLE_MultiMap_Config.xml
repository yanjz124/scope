<!-- EXAMPLE: Multi-Map Configuration for DGScope -->
<!-- This shows how to configure multiple video maps -->

<!-- IMPORTANT: The XML only supports ONE VideoMapFilename, not multiple! -->
<!-- To use multiple maps, you must:
     1. Import all your separate GeoJSON files via VideoMapForm UI
     2. Save them to ONE consolidated file
     3. Reference that ONE file here
-->

<!-- Step 0: Point to your ONE consolidated GeoJSON file -->
<VideoMapFilename>C:\Users\JY\Documents\scope-1\Maps\ILM_AllMaps.geojson</VideoMapFilename>
<!-- This ONE file contains ALL your maps (created via VideoMapForm import+save) -->

<!-- Step 1: Configure which maps are assigned to DCB buttons -->
<TCP>
  <DCBMapList>
    <!-- Each entry maps a DCB button (1-32) to a map number -->
    <int>1</int>   <!-- Button 1 (main menu MAP 1) controls Map #1 -->
    <int>2</int>   <!-- Button 2 (main menu MAP 2) controls Map #2 -->
    <int>3</int>   <!-- Button 3 (main menu MAP 3) controls Map #3 -->
    <int>4</int>   <!-- Button 4 (main menu MAP 4) controls Map #4 -->
    <int>5</int>   <!-- Button 5 (main menu MAP 5) controls Map #5 -->
    <int>6</int>   <!-- Button 6 (main menu MAP 6) controls Map #6 -->
    <!-- Buttons 7-32 are in the MAPS submenu -->
    <int>7</int>   <!-- Button 7 (MAPS submenu) controls Map #7 -->
    <int>8</int>
    <int>9</int>
    <int>10</int>
    <!-- ... up to 32 total buttons ... -->
    <int>0</int>   <!-- 0 means button not assigned -->
    <int>0</int>
    <!-- Fill remaining slots up to 36 with zeros -->
  </DCBMapList>
</TCP>

<!-- Step 2: Set which maps are initially visible -->
<CurrentPrefSet>
  <DisplayedMaps>
    <int>1</int>   <!-- Map #1 starts visible -->
    <int>3</int>   <!-- Map #3 starts visible -->
    <!-- Add more map numbers to show on startup -->
  </DisplayedMaps>

  <!-- Step 3: Configure brightness for each category -->
  <Brightness>
    <MapA>100</MapA>   <!-- Category A maps brightness (5-100) -->
    <MapB>80</MapB>    <!-- Category B maps brightness (5-100) -->
  </Brightness>
</CurrentPrefSet>

<!-- Step 4: Colors for each category -->
<VideoMapLineColor>-12566464</VideoMapLineColor>   <!-- Category A color (ARGB) -->
<VideoMapLineColorB>-14671840</VideoMapLineColorB> <!-- Category B color (ARGB) -->

<!--
NOTES:
1. Map numbers must match those in your GeoJSON file
2. You can have unlimited maps, but only 32 can have DCB buttons
3. Access all maps via Ctrl+F2 (VideoMapSelector)
4. Category (A or B) is set in the GeoJSON file metadata
-->
